{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Comentify",
  "theme": "maple",
  "colors": {
    "primary": "#5048e5",
    "light": "#A5A1F5",
    "dark": "#3730A3"
  },
  "logo": {
    "light": "https://media.brand.dev/ca3bd842-6cf7-4ad1-b79a-e149a9218114.png",
    "dark": "https://media.brand.dev/d0696e6d-a70f-468f-afb4-51795bc9b2d8.png"
  },
  "favicon": "https://media.brand.dev/0f0072fc-41d3-4357-9a41-69ddc6516448.png",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Go to App",
      "href": "https://comentify.io/"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "get-started/introduction",
              "get-started/quickstart",
              "get-started/create-workspace",
              "get-started/choose-plan",
              "get-started/dashboard"
            ]
          },
          {
            "group": "Channels",
            "pages": [
              "channels/connect-accounts",
              "channels/ice-breakers"
            ]
          },
          {
            "group": "Contacts & Inbox",
            "pages": [
              "inbox/contacts",
              "inbox/shared-inbox"
            ]
          },
          {
            "group": "Automations & Flows",
            "pages": [
              "automation/automations",
              "automation/write-messages",
              "automation/flows",
              "automation/flow-steps",
              "automation/keyword-in-use"
            ]
          },
          {
            "group": "Activity log",
            "pages": [
              "activity/activity-log",
              "activity/meta-activity-log"
            ]
          },
          {
            "group": "Setup",
            "pages": [
              "setup/team-roles",
              "setup/statuses-sources-groups",
              "setup/canned-replies"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "settings/workspace",
              "settings/billing",
              "settings/account"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://comentify.io/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    { "source": "/connecting-accounts", "destination": "/channels/connect-accounts" },
    { "source": "/inbox/lead-capture", "destination": "/inbox/contacts" },
    { "source": "/automation/comment-replies", "destination": "/automation/automations" },
    { "source": "/automation/dm-automation", "destination": "/automation/automations" },
    { "source": "/automation/workflows", "destination": "/automation/flows" },
    { "source": "/team/team-access", "destination": "/setup/team-roles" },
    { "source": "/account/plans", "destination": "/settings/billing" },
    { "source": "/account/settings", "destination": "/settings/workspace" },
    { "source": "/ai/overview", "destination": "/get-started/dashboard" },
    { "source": "/ai/ai-replies", "destination": "/get-started/dashboard" },
    { "source": "/analytics/overview", "destination": "/get-started/dashboard" },
    { "source": "/account/faq", "destination": "/get-started/introduction" },
    { "source": "/introduction", "destination": "/get-started/introduction" },
    { "source": "/quickstart", "destination": "/get-started/quickstart" },
    { "source": "/create-workspace", "destination": "/get-started/create-workspace" },
    { "source": "/choose-plan", "destination": "/get-started/choose-plan" },
    { "source": "/dashboard", "destination": "/get-started/dashboard" }
  ],
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Geist"
  }
}
